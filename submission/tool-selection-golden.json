{
  "version": 2,
  "purpose": "Golden prompt set for ReMCP tool-selection regression testing in ChatGPT Developer mode. Record actual selected tools and compare with expected sequences before releases.",
  "categories": [
    "direct",
    "indirect",
    "negative"
  ],
  "cases": [
    {
      "id": "direct-native-ui-snapshot",
      "kind": "direct",
      "prompt": "On my paired laptop, use the native accessibility tree to inspect the active app before doing anything.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "ui_snapshot"
          }
        ],
        "must_not_call": [
          {
            "tool": "view_image",
            "operation": "take_screenshot"
          },
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ]
      },
      "rationale": "Native semantic inspection should precede pixels or coordinates."
    },
    {
      "id": "direct-browser-dom",
      "kind": "direct",
      "prompt": "Use ReMCP browser DOM tools to find the Save button in the open Chromium page and click it, then wait until Saved appears.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_browser",
            "operation": "browser_tabs"
          },
          {
            "tool": "control_browser",
            "operation": "browser_find"
          },
          {
            "tool": "control_browser",
            "operation": "browser_action"
          },
          {
            "tool": "control_browser",
            "operation": "browser_wait"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          },
          {
            "tool": "control_computer",
            "operation": "ui_action"
          },
          {
            "tool": "control_browser",
            "operation": "browser_evaluate"
          }
        ]
      },
      "rationale": "Known web-page task should stay in CDP/DOM and use semantic wait."
    },
    {
      "id": "direct-type-text",
      "kind": "direct",
      "prompt": "Type this exact Unicode text into the focused editor on my laptop: Zażółć gęślą jaźń 👋",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "type_text"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "keyboard"
          },
          {
            "tool": "control_computer",
            "operation": "clipboard"
          }
        ]
      },
      "rationale": "Normal Unicode prose belongs to type_text, not key-by-key shortcuts."
    },
    {
      "id": "direct-keyboard-shortcut",
      "kind": "direct",
      "prompt": "On my paired computer press Ctrl+L, then Escape.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "keyboard"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "type_text"
          }
        ]
      },
      "rationale": "Shortcuts and control keys belong to keyboard."
    },
    {
      "id": "direct-coordinate-pointer",
      "kind": "direct",
      "prompt": "Click exactly at screen coordinates 640, 420 on my paired computer.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "ui_action"
          },
          {
            "tool": "control_browser",
            "operation": "browser_action"
          }
        ]
      },
      "rationale": "The user explicitly requested a coordinate action."
    },
    {
      "id": "direct-drag-drop",
      "kind": "direct",
      "prompt": "Drag the accessible item named Report.pdf onto the accessible folder named Archive.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "ui_find"
          },
          {
            "tool": "control_computer",
            "operation": "drag_drop"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ]
      },
      "rationale": "Semantic drag endpoints are more stable than coordinate mouse choreography."
    },
    {
      "id": "direct-window-management",
      "kind": "direct",
      "prompt": "Find the Chrome window on my paired laptop and maximize it.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "list_windows"
          },
          {
            "tool": "control_computer",
            "operation": "window_action"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ]
      },
      "rationale": "Window operations should use window ids rather than desktop coordinates."
    },
    {
      "id": "direct-browser-new-tab",
      "kind": "direct",
      "prompt": "Open https://example.com as a new debuggable Chrome tab through ReMCP.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_browser",
            "operation": "browser_navigate"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "keyboard"
          },
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ],
        "arguments": {
          "control_browser/browser_navigate": {
            "action": "new_tab"
          }
        }
      },
      "rationale": "new_tab bootstraps CDP even when no page target exists."
    },
    {
      "id": "direct-native-file-result",
      "kind": "direct",
      "prompt": "Read README.md from my paired computer, summarize it, and show the result here in chat.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "read_file"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "open_path"
          },
          {
            "tool": "render_file_preview"
          }
        ]
      },
      "rationale": "The default production path ends with the model-readable file result; custom UI is not required."
    },
    {
      "id": "direct-native-image-result",
      "kind": "direct",
      "prompt": "Take a screenshot of my paired computer and show it here in chat.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "view_image",
            "operation": "take_screenshot"
          }
        ],
        "must_not_call": [
          {
            "tool": "manage_files",
            "operation": "read_binary"
          },
          {
            "tool": "render_image_preview"
          }
        ]
      },
      "rationale": "The screenshot tool already returns native MCP image content for the host and model."
    },
    {
      "id": "direct-native-terminal-result",
      "kind": "direct",
      "prompt": "Run npm test on my paired laptop and show the terminal output here in chat.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "run_terminal",
            "operation": "start_process"
          }
        ],
        "must_not_call": [
          {
            "tool": "render_terminal_preview"
          }
        ]
      },
      "rationale": "The command runs once and its normal MCP result is the default terminal presentation path."
    },
    {
      "id": "indirect-first-look",
      "kind": "indirect",
      "prompt": "What is open on my laptop right now, and what can I interact with?",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "computer_snapshot"
          }
        ],
        "must_not_call": [
          {
            "tool": "view_image",
            "operation": "take_screenshot"
          }
        ]
      },
      "rationale": "An unfamiliar mixed desktop state is the intended computer_snapshot use case."
    },
    {
      "id": "indirect-native-settings-toggle",
      "kind": "indirect",
      "prompt": "Open the Settings app on my laptop, find the Bluetooth switch, turn it on, and tell me when it is enabled.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "launch_app"
          },
          {
            "tool": "control_computer",
            "operation": "ui_find"
          },
          {
            "tool": "control_computer",
            "operation": "ui_action"
          },
          {
            "tool": "control_computer",
            "operation": "wait_for_ui"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          },
          {
            "tool": "view_image",
            "operation": "take_screenshot"
          }
        ]
      },
      "rationale": "Native app semantics should drive the task end to end."
    },
    {
      "id": "indirect-web-form",
      "kind": "indirect",
      "prompt": "In the open browser page, put Anton in the Name field, choose Poland, submit, and wait for the confirmation message.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_browser",
            "operation": "browser_tabs"
          },
          {
            "tool": "control_browser",
            "operation": "browser_find"
          },
          {
            "tool": "control_browser",
            "operation": "browser_action"
          },
          {
            "tool": "control_browser",
            "operation": "browser_wait"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "type_text"
          },
          {
            "tool": "control_computer",
            "operation": "pointer"
          },
          {
            "tool": "control_browser",
            "operation": "browser_evaluate"
          }
        ]
      },
      "rationale": "Page content should stay in DOM/CDP when available."
    },
    {
      "id": "indirect-wait-native",
      "kind": "indirect",
      "prompt": "Click the native Export button and continue only after the Export complete text appears.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "ui_find"
          },
          {
            "tool": "control_computer",
            "operation": "ui_action"
          },
          {
            "tool": "control_computer",
            "operation": "wait_for_ui"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          },
          {
            "tool": "view_image",
            "operation": "take_screenshot"
          }
        ]
      },
      "rationale": "Semantic wait is preferred to sleeps or screenshot polling."
    },
    {
      "id": "indirect-visual-proof",
      "kind": "indirect",
      "prompt": "After fixing the visible layout, verify that the final card is not clipped on screen.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "view_image",
            "operation": "screenshot_region"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "record_screen"
          }
        ]
      },
      "rationale": "Static pixel/layout proof belongs to a targeted screenshot."
    },
    {
      "id": "indirect-motion-proof",
      "kind": "indirect",
      "prompt": "The menu animation jitters during opening. Capture a short recording so we can debug the timing.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "record_screen"
          }
        ],
        "must_not_call": [
          {
            "tool": "view_image",
            "operation": "screenshot_region"
          }
        ]
      },
      "rationale": "Motion/timing debugging requires recording, not a static image."
    },
    {
      "id": "indirect-read-spreadsheet",
      "kind": "indirect",
      "prompt": "Tell me the values and formulas in Sheet1 of budget.xlsx on my paired computer without opening Excel.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "manage_documents",
            "operation": "read_document"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "launch_app"
          },
          {
            "tool": "control_computer",
            "operation": "open_path"
          }
        ]
      },
      "rationale": "Structured document content should not drive a GUI app."
    },
    {
      "id": "indirect-edit-spreadsheet",
      "kind": "indirect",
      "prompt": "Change B2 in budget.xlsx to 1250 and set C2 to =B2*1.23, then verify the cells.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "manage_documents",
            "operation": "edit_spreadsheet"
          },
          {
            "tool": "manage_documents",
            "operation": "read_document"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "launch_app"
          },
          {
            "tool": "control_computer",
            "operation": "ui_action"
          }
        ]
      },
      "rationale": "Direct XLSX editing is deterministic and should be read back."
    },
    {
      "id": "indirect-pdf-pages",
      "kind": "indirect",
      "prompt": "Extract pages 2 through 4 from report.pdf into report-excerpt.pdf.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "manage_documents",
            "operation": "pdf_action"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "launch_app"
          },
          {
            "tool": "run_terminal",
            "operation": "start_process"
          }
        ]
      },
      "rationale": "PDF structure operation should use pdf_action."
    },
    {
      "id": "indirect-service-restart",
      "kind": "indirect",
      "prompt": "Check whether nginx is running on my server and restart it if it is unhealthy.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "manage_system",
            "operation": "service"
          }
        ],
        "must_not_call": [
          {
            "tool": "run_terminal",
            "operation": "start_process"
          }
        ]
      },
      "rationale": "Service-manager operations should use the service tool."
    },
    {
      "id": "indirect-network-test",
      "kind": "indirect",
      "prompt": "From my paired server, check whether db.internal.example on TCP port 5432 is reachable.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "manage_system",
            "operation": "network"
          }
        ],
        "must_not_call": [
          {
            "tool": "run_terminal",
            "operation": "start_process"
          }
        ]
      },
      "rationale": "Bounded connectivity test is structured and safer than shell networking commands."
    },
    {
      "id": "indirect-browser-js-escape-hatch",
      "kind": "indirect",
      "prompt": "On the current debug page, return the value of window.__APP_BUILD__ which is not exposed in the DOM.",
      "expected": {
        "action": "call",
        "sequence": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_browser",
            "operation": "browser_tabs"
          },
          {
            "tool": "control_browser",
            "operation": "browser_evaluate"
          }
        ],
        "must_not_call": [
          {
            "tool": "control_computer",
            "operation": "pointer"
          }
        ]
      },
      "rationale": "browser_evaluate is justified only because supported DOM tools cannot expose the JS-only value."
    },
    {
      "id": "negative-weather",
      "kind": "negative",
      "prompt": "What is the weather in Rzeszów tomorrow?",
      "expected": {
        "action": "alternative",
        "alternative": "weather",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "computer_snapshot"
          }
        ]
      },
      "rationale": "Use the platform weather capability; ReMCP is unrelated."
    },
    {
      "id": "negative-web-search",
      "kind": "negative",
      "prompt": "Search the web for the latest OpenAI plugin documentation.",
      "expected": {
        "action": "alternative",
        "alternative": "web_search",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_browser",
            "operation": "browser_navigate"
          }
        ]
      },
      "rationale": "General web research should use web search, not a user's paired computer."
    },
    {
      "id": "negative-pasted-text",
      "kind": "negative",
      "prompt": "Summarize the paragraph I pasted above.",
      "expected": {
        "action": "none",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "read_file"
          }
        ]
      },
      "rationale": "The conversation already contains the data."
    },
    {
      "id": "negative-image-generation",
      "kind": "negative",
      "prompt": "Generate a watercolor illustration of a lighthouse.",
      "expected": {
        "action": "alternative",
        "alternative": "image_generation",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "open_path"
          }
        ]
      },
      "rationale": "Image generation is a platform capability, not remote computer control."
    },
    {
      "id": "negative-reminder",
      "kind": "negative",
      "prompt": "Remind me tomorrow at 9 AM to call the dentist.",
      "expected": {
        "action": "alternative",
        "alternative": "automation",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "control_computer",
            "operation": "notification"
          }
        ]
      },
      "rationale": "A future reminder is not a native notification on a paired device."
    },
    {
      "id": "negative-calculation",
      "kind": "negative",
      "prompt": "What is 17% of 840?",
      "expected": {
        "action": "alternative",
        "alternative": "calculator",
        "sequence": [],
        "must_not_call": [
          {
            "tool": "list_devices"
          },
          {
            "tool": "run_terminal",
            "operation": "start_process"
          }
        ]
      },
      "rationale": "Simple arithmetic should not invoke a remote machine."
    }
  ]
}
